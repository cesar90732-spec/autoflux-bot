# ============================================
# AutoFlux Atendimento - Variáveis de Ambiente
# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA suba o arquivo ".env" real para o repositório.
# ============================================

# --- Aplicação ---
NODE_ENV=development
PORT=3333
APP_URL=http://localhost:3333
FRONTEND_URL=http://localhost:5173

# --- Banco de dados PostgreSQL ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=autoflux
DB_PASSWORD=troque_esta_senha
DB_NAME=autoflux_db
# String de conexão completa (usada pelo pg pool)
DATABASE_URL=postgresql://autoflux:troque_esta_senha@postgres:5432/autoflux_db

# --- Redis (filas de mensagens e sessões) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- Autenticação ---
# Gere um valor aleatório forte, ex: openssl rand -hex 32
JWT_SECRET=troque_este_segredo_jwt
JWT_EXPIRES_IN=7d

# --- Rate limiting / segurança ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# --- Integrações de IA (preencha a(s) que for usar) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- WhatsApp (serviço Baileys - Etapa 2) ---
WHATSAPP_SESSION_DIR=./sessions

# --- Cobrança (Pix direto, sem gateway/API) ---
# PIX_KEY: sua chave Pix (a mesma cadastrada no seu PicPay pessoal)
# PIX_OWNER_NAME: seu nome, até 25 caracteres, sem acento
# PIX_OWNER_CITY: sua cidade, até 15 caracteres, sem acento
PIX_KEY=
PIX_OWNER_NAME=
PIX_OWNER_CITY=

# --- Backup automático ---
BACKUP_DIR=./backups
BACKUP_CRON="0 3 * * *"
# Backups mais antigos que isso (em dias) são apagados automaticamente
BACKUP_RETENTION_DAYS=14
